# Bài 06 · Chặng 2 — Terminal B: đổi email cùng lúc với A (slide 30). Dán ở B TRƯỚC khi dán ở A.

# #region lost · B đọc JSON cùng lúc với A, ghi đè sau A (slide 30)
BLPOP l06:barrier:json-race 5
# B đọc lúc age còn 30, đổi email trong code, ghi đè cả chuỗi SAU A → age 31 của A mất.
GET l06:user:1:json
#@ sleep 1
SET l06:user:1:json '{"id":1,"name":"Dat","age":30,"email":"dat@xyz.vn"}'
#@ sleep 0.2
GET l06:user:1:json
# Kiểu Hash: B chỉ ghi đúng trường email → không đè trường age của A.
#@ sleep 1
HSET l06:user:1 email dat@xyz.vn
#@ sleep 0.3
HMGET l06:user:1 age email
# #endregion
